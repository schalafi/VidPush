# Server — safe to commit (placeholders only).
# Locally: copy to `.env`, fill in secrets; never commit `.env` or `.env.local.example`.
PORT=3000
FRONTEND_URL=http://localhost:5173

# Local API lock — required. Generate once: openssl rand -hex 32
# You enter this in the browser unlock screen; it is never stored in the repo or client code.
VIDPUSH_API_KEY=

# Stub user for PoC; future: real session user id
DEFAULT_USER_ID=default

# Google Cloud OAuth (YouTube Data API v3)
# Redirect URI must match Google Console: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# TikTok Login Kit + Content Posting (video.publish, user.info.basic)
# Reserved ngrok domain — keep private; set the same host in TIKTOK_REDIRECT_URI and TikTok portal.
NGROK_DOMAIN=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://YOUR-SUBDOMAIN.ngrok-free.dev/api/auth/tiktok/callback
