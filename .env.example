# Server — safe to commit (placeholders only).
# Locally: copy to `.env`, fill in secrets; never commit `.env` or `.env.local.example`.
PORT=3000
FRONTEND_URL=http://localhost:5173

# Sign-in uses a separate Google OAuth client from YouTube publishing.
APP_AUTH_PROVIDER=google
GOOGLE_ALLOWED_EMAIL=doublef.corp@gmail.com
GOOGLE_LOGIN_CLIENT_ID=
GOOGLE_LOGIN_CLIENT_SECRET=
GOOGLE_LOGIN_REDIRECT_URI=http://localhost:3000/api/auth/login/google/callback
COOKIE_SECURE=false

# Optional legacy local development mode: APP_AUTH_PROVIDER=key.
# Generate the access key with openssl rand -hex 32.
VIDPUSH_API_KEY=

# Shared single-owner publishing workspace (preserves existing connections)
DEFAULT_USER_ID=default

# Google Cloud OAuth (YouTube Data API v3)
# Redirect URI must match Google Console: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# TikTok Login Kit + Content Posting (video.publish, user.info.basic)
# Reserved ngrok domain — keep private; set the same host in TIKTOK_REDIRECT_URI and TikTok portal.
NGROK_DOMAIN=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://YOUR-SUBDOMAIN.ngrok-free.dev/api/auth/tiktok/callback

# Facebook Page publishing — separate from Instagram login
# Register exact callbacks in your Meta app. Production requires HTTPS.
META_API_VERSION=v24.0
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=https://YOUR-APP-HOST/api/auth/facebook/callback

# Instagram API with Instagram Login — Business or Creator account
# Use the Instagram App ID/Secret shown under Instagram API setup.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=https://YOUR-APP-HOST/api/auth/instagram/callback
