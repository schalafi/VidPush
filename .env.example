# VidPush environment reference — safe to commit (placeholders only).
# Locally: copy to `.env`, fill in secrets; never commit `.env`.
# Production (Modal): the SAME keys live in the `vidpush-config` secret
# (workspace `schalafi`, environment `vidpush`). `modal_app.py`
# `required_keys` enforces the production set below at deploy time.
# Keys marked [optional] have code defaults; everything else is required
# wherever its feature is used.

# --- Server ---
PORT=3000
FRONTEND_URL=http://localhost:5173
# [optional] SQLite directory. Defaults to `.env`-relative `.data`;
# production sets it to the `vidpush-data` volume mount (`/data`).
DATA_DIR=
# [optional] Set to `production` by the Modal image; leave unset locally.
NODE_ENV=

# --- Sign-in (Google owner login) ---
# Sign-in uses a separate Google OAuth client from YouTube publishing.
APP_AUTH_PROVIDER=google
GOOGLE_ALLOWED_EMAIL=doublef.corp@gmail.com
GOOGLE_LOGIN_CLIENT_ID=
GOOGLE_LOGIN_CLIENT_SECRET=
GOOGLE_LOGIN_REDIRECT_URI=http://localhost:3000/api/auth/login/google/callback
COOKIE_SECURE=false

# [optional] Legacy local development mode: APP_AUTH_PROVIDER=key.
# Generate the access key with openssl rand -hex 32. Not used in production.
VIDPUSH_API_KEY=

# [optional] Shared single-owner publishing workspace (preserves connections).
DEFAULT_USER_ID=default

# --- YouTube publishing (Google Cloud OAuth, YouTube Data API v3) ---
# Redirect URI must match Google Console: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# --- TikTok publishing (Login Kit + Content Posting) ---
# Reserved ngrok domain for local OAuth callbacks — keep private; set the
# same host in TIKTOK_REDIRECT_URI and the TikTok portal.
NGROK_DOMAIN=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://YOUR-SUBDOMAIN.ngrok-free.dev/api/auth/tiktok/callback

# --- Meta: API version ---
# [optional] Defaults to v24.0 in code; set explicitly to pin upgrades.
META_API_VERSION=v24.0

# --- Facebook Page publishing (Facebook Login) ---
# Register exact callbacks in your Meta app. Production requires HTTPS.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=https://YOUR-APP-HOST/api/auth/facebook/callback

# --- Instagram publishing (Instagram API with Instagram Login) ---
# Use the Instagram App ID/Secret shown under Instagram API setup (separate
# from the Facebook app credentials). Account must be Business or Creator.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=https://YOUR-APP-HOST/api/auth/instagram/callback
